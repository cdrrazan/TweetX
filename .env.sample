# X API — OAuth 1.0a user context. These four are the only variables this
# CLI actually reads; Scheduler signs every request with them.
X_API_KEY=YOUR_API_KEY
X_API_KEY_SECRET=YOUR_API_KEY_SECRET
X_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
X_ACCESS_TOKEN_SECRET=YOUR_ACCESS_TOKEN_SECRET

# Issued by the X developer portal but unused here. Keep them for reference if
# you move to OAuth 2.0 or app-only endpoints.
X_BEARER_TOKEN=YOUR_BEARER_TOKEN
X_CLIENT_ID=YOUR_CLIENT_ID
X_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Note: X_USERNAME, TWEETX_USER and TWEETX_PASS belong to the web dashboard
# (see the TweetX-web repository) and are not read by this CLI.
